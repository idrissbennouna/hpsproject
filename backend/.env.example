# Clé API Google Gemini (Requise pour le fonctionnement des agents LLM)
GOOGLE_API_KEY=TaCleGeminiIci

# Modèle de LLM par défaut à utiliser (ex: gemini-2.5-flash)
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- BUDGET VIRTUEL INTERNE DE TOKENS ---
# Spécifie la limite de tokens consommés autorisés pour la session / démo.
# IMPORTANT : Ce quota est un mécanisme purement interne au projet ComplianceVerifier 
# pour avertir les utilisateurs de la consommation, et non une vraie limite imposée par Google.
TOKEN_BUDGET_LIMIT=10000000
